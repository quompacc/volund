# Copy to .env next to compose.yaml and adjust.
VOLUND_VERSION=0.41.0
VOLUND_IMAGE=volund:0.41.0
VOLUND_DB_IMAGE=volund-db:0.41.0
# Rebuildable and database data: postgres/, derived/, scratch/, incoming/, support/, secrets/
VOLUND_DATA=/srv/volund
# Authoritative CAD libraries
VOLUND_LIBRARY=/srv/volund/library
# Validated database dumps; must be on a different device than VOLUND_LIBRARY
VOLUND_BACKUP_DIR=/var/backups/volund
VOLUND_PUBLIC_BASE_URL=https://volund.example.internal
# External Docker network shared with the reverse proxy
VOLUND_PROXY_NETWORK=proxy
