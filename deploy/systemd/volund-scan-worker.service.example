[Unit]
Description=VÖLUND durable library scan worker
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=volund
Group=volund
ExecStart=/usr/local/bin/volundd process-next-scan
EnvironmentFile=-/etc/volund/volund.env
WorkingDirectory=/srv/volund
UMask=0027
TimeoutStartSec=2h
MemoryHigh=2G
MemoryMax=3G
MemorySwapMax=512M
TasksMax=80
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/srv/volund/library

